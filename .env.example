# Copy this file to .env and fill in the values. Never commit .env.

# --- Local S3-compatible storage (RustFS) ---
# Pin a specific tag from https://hub.docker.com/r/rustfs/rustfs/tags before recording.
RUSTFS_VERSION=latest
RUSTFS_ACCESS_KEY=localadmin
RUSTFS_SECRET_KEY=change-me-please
S3_BUCKET=fuel-raw

# --- MIMIT open data ---
# Copy the two links from the MIMIT page
# "Carburanti - Prezzi praticati e anagrafica degli impianti" (right click > copy link address).
MIMIT_PRICES_URL=
MIMIT_STATIONS_URL=
